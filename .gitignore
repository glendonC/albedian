# Dependencies
node_modules/
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.hypothesis/
.ruff_cache/

# Build outputs
dist/
build/
*.tsbuildinfo
.vite/

# Runtime & user media storage (never commit private user media or credentials)
.runtime/
data/uploads/
data/artifacts/
data/ingest/
data/renders/
apps/web/public/splats/*.rad
apps/web/public/splats/*.zip
*.sqlite
*.sqlite3
*.db

# Environment & secrets
.env
.env.*
!.env.example

# OS & editor files
.DS_Store
Thumbs.db
*.swp
*.swo

# Internal ops files: local only, never committed
docs/internal/

# Kiro local IDE settings: machine-specific, not project config
.kiro/settings/

# NOTE: .kiro specs, steering, hooks, and agents ARE intentionally tracked.
!/.kiro/specs/
!/.kiro/steering/
!/.kiro/hooks/
!/.kiro/agents/

# Claude Code session worktrees: full repo copies the desktop app manages, never committed
.claude/worktrees/

# Offline bake caches (archive responses for scripts/bake_catalog_star_tiles.py)
.cache/

# Look-dev source data (NASA downloads) and renders, reproducible from scripts/lookdev
data/lookdev/
