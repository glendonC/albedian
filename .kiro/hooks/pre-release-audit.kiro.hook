{
  "name": "Pre-Release Judge Readiness Audit",
  "version": "1.0.0",
  "description": "Runs the full TypeScript and Python test suites and the contract, documentation, and provenance verification scripts.",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "pnpm test:all && pnpm verify:contracts && pnpm verify:docs && pnpm verify:provenance",
    "timeout": 180000
  }
}
