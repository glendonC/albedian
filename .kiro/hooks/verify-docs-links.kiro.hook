{
  "name": "Verify Documentation & Spec Traceability Links",
  "version": "1.0.0",
  "description": "Validates local markdown links, Kiro specification completeness, and contract references when documentation or specs are edited.",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "README.md",
      "AGENTS.md",
      "docs/**/*.md",
      "research/experiments/EXPERIMENT_REGISTRY.md",
      ".kiro/specs/**/*.md"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "node scripts/verify-docs.mjs",
    "timeout": 30000
  }
}
