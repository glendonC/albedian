  "selection": {
    "gaia": "gaiadr3.gaia_source with phot_g_mean_mag < 12.0, left join external.gaiaedr3_distance on source_id; no other quality cuts",
    "gaiaQueryTemplate": "SELECT g.source_id, g.ra, g.dec, g.phot_g_mean_mag, g.bp_rp, g.pmra, g.pmdec, g.radial_velocity, d.r_med_photogeo, d.r_lo_photogeo, d.r_hi_photogeo, d.r_med_geo, d.r_lo_geo, d.r_hi_geo FROM gaiadr3.gaia_source AS g LEFT OUTER JOIN external.gaiaedr3_distance AS d ON d.source_id = g.source_id WHERE g.source_id BETWEEN {lo} AND {hi} AND g.phot_g_mean_mag < 12.0",
    "gaiaChunks": 207,
    "hipparcosQuery": "SELECT h.hip, h.ra, h.dec, h.plx, h.e_plx, h.pm_ra, h.pm_de, h.hp_mag, h.b_v, x.source_id AS gaia_source_id, g.phot_g_mean_mag AS gaia_g FROM public.hipparcos_newreduction AS h LEFT OUTER JOIN gaiadr3.hipparcos2_best_neighbour AS x ON x.original_ext_source_id = h.hip LEFT OUTER JOIN gaiadr3.gaia_source AS g ON g.source_id = x.source_id WHERE h.hp_mag < 6.0 ORDER BY h.hip",
    "brightStars": {
      "rule": "A Hipparcos star replaces Gaia when it has no Gaia DR3 best neighbour (and no unsaturated Gaia source within 10 arcsec agrees within 1 mag, or sits within 2 arcsec no more than 1 mag fainter), when its best neighbour is brighter than G 3 or outside the G < 12 subset, or when a Gaia source brighter than G 3 within 10 arcsec matches the Hipparcos magnitude better than the best neighbour (the crossmatch picked a companion). Gaia sources within 2 arcsec of a Hipparcos-supplied star, or within 10 arcsec and agreeing within 1.5 mag or brighter than G 3, are removed as duplicates; fainter companions stay. Remaining Gaia sources brighter than G 3 are removed.",
      "hipparcosMagnitudeLimit": 6.0,
      "gaiaPoorBrighterThan": 3.0,
      "duplicateRadiusArcsec": 10.0,
      "sameStarRadiusArcsec": 2.0,
      "duplicateSearchMagnitudeLimit": 7.5,
      "hipparcosEpoch": 1991.25,
      "log": "bright-star-merge.json"
    },
