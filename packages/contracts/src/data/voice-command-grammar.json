{
  "format": "albedian.voice-command-grammar",
  "formatVersion": 1,
  "about": "The words that ask for each voice command and the order the commands are tried, read by both parsers (packages/observation/src/voiceGrammar.ts and services/voice/grammar.py) so the two cannot drift. Each rule names the contract action it forms. match: words (any phrase as whole words, a phrase with ' ... ' between two parts asks for the second part later in the same sentence), start (the request starts with a phrase), whole (the request is a phrase), year (a year said, read by code), seconds (a phrase, then a number of seconds), name (a thing the request names), rest (anything left becomes a question). target, for an action on one finding: view (said alone, it acts on what is in view), which (said alone, it asks which one), about (said alone, it is no command and the next rule is tried), named (it applies only when the words name or point at a thing that is found). with holds fixed fields of the action; the first modifier whose word the request holds changes them. namesRefusedBefore is the rule before which a name the sky does not hold, or cannot reach, is refused. A rule that changes the scene acts only when every word of the request is accounted for: by the rule's own phrase and modifier words, the names it reads, the pointing words, for a rule with a target the describing words it reads, the numbers its code reads, and the unchanging words, each group with why it is there. Any other word means no action (not_a_request), and a second such request in the sentence means neither (two_requests). A rule whose action is in describingActions only describes and keeps its reading. folds are read first: each typographic apostrophe or quote as its plain one (answers-3b v4). Written by hand from the phrases both parsers read on 2026-11-12 (answers-3b).",
  "namesRefusedBefore": "seek",
  "folds": { "\u2019": "'", "\u2018": "'", "\u02bc": "'", "\u201c": "\"", "\u201d": "\"" },
  "unchanging": [
    { "words": ["a", "an", "the"], "why": "An article names no other thing: fly to the star asks what fly to star asks." },
    { "words": ["please", "thanks", "thank you"], "why": "Politeness asks for nothing more and nothing less." },
    { "words": ["hey", "hi", "hello", "ok", "okay"], "why": "A greeting or an assent said before a request is no request of its own." },
    { "words": ["can you", "could you", "would you", "can i", "can we", "let's", "i want to", "i want you to"], "why": "A request put as a polite question or a wish is the same request; a word that changes it is not here, so it still stops the action." },
    { "words": ["um", "uh", "er", "hmm", "oh", "so", "well", "yes", "yeah"], "why": "Sounds and words speech fills a pause or agrees with; they ask for nothing." },
    { "words": ["to", "of", "in"], "why": "The words that lead to the thing a request is about or to where it is: take me there, to Vega; the brightest star in the photo." },
    { "words": ["now", "again"], "why": "When a request is said, or that it is said again, changes nothing about what it asks: fly there now." },
    { "words": ["photo", "picture", "image", "video", "recording"], "why": "The recording is what every request acts on: naming it changes nothing (restore the photo)." },
    { "words": ["me"], "why": "Whom the scene is shown to does not change the scene: show me the planets." },
    { "words": ["albedian"], "why": "The app's own name, said to it." }
  ],
  "describingActions": ["finding.describe"],
  "rules": [
    { "id": "word_question", "action": "question.ask", "match": "words", "phrases": ["what does ... mean", "what do ... mean", "why does it say", "why is it called", "difference between", "what is meant by", "what's meant by", "meaning of", "what does it mean"] },
    { "id": "cancel_alone", "action": "navigation.cancel", "match": "whole", "phrases": ["stop", "cancel", "wait", "halt", "abort", "freeze", "hold on", "stop it", "cancel that", "stop that", "stop please", "please stop", "stop that please", "stop it please", "cancel please", "please cancel"] },
    { "id": "cancel_words", "action": "navigation.cancel", "match": "words", "phrases": ["stop navigation", "stop transition", "stop flight", "stop the flight", "stop flying", "stop moving", "stop the transition", "cancel the flight", "cancel navigation", "cancel transition", "cancel flight", "pause transition"] },
    { "id": "back_a_little", "action": "history.back", "match": "words", "phrases": ["go back a little", "go back a bit", "back a little", "back a bit", "step back slightly", "slightly back", "partial back"], "with": { "mode": "partial", "fraction": 0.35 } },
    { "id": "back_halfway", "action": "history.back", "match": "words", "phrases": ["halfway back", "partway back", "go back halfway", "go back partway", "step back halfway", "step back partway"], "with": { "mode": "partial", "fraction": 0.5 } },
    { "id": "back_to_checkpoint", "action": "history.back", "match": "words", "phrases": ["go back to the previous checkpoint", "go back to the last checkpoint", "previous checkpoint", "last checkpoint", "checkpoint back"], "with": { "mode": "checkpoint" } },
    { "id": "back_alone", "action": "source.return", "match": "whole", "phrases": ["back"] },
    { "id": "back_to_moment", "action": "source.return", "match": "words", "phrases": ["take me back", "back to moment", "back to the moment", "return to source", "back to source", "back to recording", "back to photo", "back to video", "back to my video", "back to the video", "return to original", "original recording", "go back", "return home"] },
    { "id": "step_back", "action": "history.back", "match": "words", "phrases": ["step back"], "with": { "mode": "checkpoint" } },
    { "id": "epoch", "action": "space.epoch", "match": "year", "phrases": ["show", "sky", "in", "as it was", "as it looked"] },
    { "id": "earth_direction", "action": "ui.overlay", "match": "words", "phrases": ["where is earth", "earth direction", "point to earth", "direction to earth", "home vector"], "with": { "overlay": "earthDirectionVector", "enabled": true }, "modifiers": [{ "words": ["hide", "off", "disable", "remove", "kill", "clear", "turn off", "switch off"], "with": { "enabled": false } }, { "words": ["show", "on", "display", "turn on", "switch on", "turn", "switch"], "with": { "enabled": true } }] },
    { "id": "constellation_lines", "action": "ui.overlay", "match": "words", "phrases": ["constellation lines", "constellations overlay", "star lines"], "with": { "overlay": "constellationLines", "enabled": true }, "modifiers": [{ "words": ["hide", "off", "disable", "remove", "kill", "clear", "turn off", "switch off"], "with": { "enabled": false } }, { "words": ["show", "on", "display", "turn on", "switch on", "turn", "switch"], "with": { "enabled": true } }] },
    { "id": "residual_vectors", "action": "ui.overlay", "match": "words", "phrases": ["residual vectors", "residuals"], "with": { "overlay": "residualVectors", "enabled": true }, "modifiers": [{ "words": ["hide", "off", "disable", "remove", "kill", "clear", "turn off", "switch off"], "with": { "enabled": false } }, { "words": ["show", "on", "display", "turn on", "switch on", "turn", "switch"], "with": { "enabled": true } }] },
    { "id": "compare_alone", "action": "media.compare", "match": "whole", "phrases": ["compare", "compare please"] },
    { "id": "compare", "action": "media.compare", "match": "words", "phrases": ["compare before and after", "compare it with the original", "compare with the original", "compare to the original", "compare the original", "compare the photos", "compare them", "show original", "show ... before and after", "before and after", "a/b wipe", "split view"] },
    { "id": "restore", "action": "media.restore", "match": "words", "phrases": ["make the sky clearer", "sky clearer", "don't change the people", "do not change the people", "preserve the people", "temporal stack", "motion-compensated", "denoise", "clean", "restore with", "restore", "clean up", "clean up ... noise", "clean ... up", "brighten", "enhance", "bring out faint stars", "reduce ... noise", "remove ... noise", "lower ... noise", "less ... noise", "fix ... noise", "lift ... shadow", "lift ... shadows", "raise ... shadow", "raise ... shadows", "open ... shadow", "open ... shadows", "recover ... shadow", "recover ... shadows"], "with": { "profile": "star_protected" }, "modifiers": [{ "words": ["natural", "tone"], "with": { "profile": "natural" } }, { "words": ["temporal", "stack", "faint"], "with": { "profile": "temporal" } }] },
    { "id": "seek", "action": "media.seek", "match": "seconds", "phrases": ["seek", "jump", "scrub"] },
    { "id": "sky", "action": "sky.show", "match": "words", "phrases": ["what were we looking at", "what was overhead", "show me what was overhead", "identify the stars", "calibrate the sky", "calibrate", "register the sky", "show sky", "show the sky", "what is in the sky", "match the sky"] },
    { "id": "viewpoint", "action": "space.viewpoint", "match": "words", "phrases": ["another viewpoint", "different viewpoint", "orbit", "another angle", "from the side", "from a different side", "show ... from a different side", "show ... from the side", "show ... from another angle", "show ... from another viewpoint", "show ... another viewpoint", "orbit around", "shift viewpoint around", "translate viewpoint around", "translate viewpoint", "shift viewpoint"], "target": "view", "with": { "trajectory": "orbit" }, "modifiers": [{ "words": ["translate", "shift"], "with": { "trajectory": "translate" } }] },
    { "id": "distance", "action": "finding.describe", "match": "words", "phrases": ["how far", "distance", "light years", "parsecs", "how distant"], "target": "view", "with": { "fields": ["distance", "evidence"] } },
    { "id": "sightline", "action": "finding.describe", "match": "words", "phrases": ["what's behind", "what is behind", "what lies beyond", "behind it", "beyond it", "behind", "beyond", "behind sightline", "along this sightline"], "target": "view", "with": { "fields": ["behind_sightline"] } },
    { "id": "flight", "action": "space.enter", "match": "words", "phrases": ["take me there", "take me to", "take me into space", "take me into 3d space", "take me into space toward", "take me into space towards", "take me into 3d space toward", "take me into 3d space towards", "take me ... toward", "take me ... towards", "fly toward", "fly towards", "fly there", "fly to", "fly", "go there", "go to", "travel to", "travel", "enter space", "enter 3d", "enter", "3d space", "into space", "zoom into space", "explore"], "target": "view" },
    { "id": "describe_kind", "action": "finding.describe", "match": "words", "phrases": ["is that a planet", "is it a planet", "is this a planet", "be a planet", "that planet"], "target": "which", "with": { "fields": ["type", "evidence"] } },
    { "id": "select", "action": "finding.select", "match": "words", "phrases": ["what's that", "what is that", "what star is that", "which star", "that one", "this one", "select", "focus on", "lock on", "lock onto", "inspect", "point at", "look at", "tell me about"], "target": "which" },
    { "id": "describe", "action": "finding.describe", "match": "words", "phrases": ["describe", "identify"], "target": "view", "with": { "fields": ["distance", "type", "motion", "evidence"] } },
    { "id": "describe_about", "action": "finding.describe", "match": "words", "phrases": ["what is", "where is"], "target": "about", "with": { "fields": ["distance", "type", "motion", "evidence"] } },
    { "id": "select_named", "action": "finding.select", "match": "words", "phrases": ["focus", "lock", "point", "show me"], "target": "named" },
    { "id": "named", "action": "finding.select", "match": "name", "target": "about" },
    { "id": "sky_predicted", "action": "sky.show", "match": "words", "phrases": ["predicted", "ephemeris", "show the predicted sky", "show me the predicted sky", "show the predicted planets", "show the planets", "show me the planets", "show planets", "where are the planets"], "with": { "mode": "predicted" } },
    { "id": "sky_measured", "action": "sky.show", "match": "words", "phrases": ["show the constellations", "show constellations", "show me the constellations"], "with": { "mode": "measured" } },
    { "id": "question", "action": "question.ask", "match": "rest" }
  ]
}
