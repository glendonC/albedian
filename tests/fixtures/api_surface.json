          "properties": {
            "profile": {
              "type": "string",
              "title": "Profile",
              "default": "star_protected"
            },
            "preserveStars": {
              "type": "boolean",
              "title": "Preservestars",
              "default": true
            },
            "frames": {
              "anyOf": [
                {
                  "items": {
                    "items": {
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    },
                    "type": "array"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Frames"
            },
            "image_luma": {
              "anyOf": [
                {
                  "items": {
                    "items": {
                      "type": "number"
                    },
                    "type": "array"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Image Luma"
            },
            "sourceAssetId": {
              "type": "string",
              "minLength": 1,
              "title": "Sourceassetid"
            }
          },
          "additionalProperties": true,
          "type": "object",
          "required": [
            "sourceAssetId"
          ],
          "title": "RestoreRequest",
          "description": "Request payload for `POST /api/media/restore`."
        },
        "SkyContextRequest": {
          "properties": {
            "observedAtUTC": {
              "type": "string",
              "title": "Observedatutc"
            },
            "latDeg": {
              "type": "number",
              "maximum": 90.0,
              "minimum": -90.0,
              "title": "Latdeg"
            },
            "lonDeg": {
              "type": "number",
              "maximum": 180.0,
              "minimum": -180.0,
              "title": "Londeg"
            }
          },
          "additionalProperties": true,
          "type": "object",
          "required": [
            "observedAtUTC",
            "latDeg",
            "lonDeg"
          ],
          "title": "SkyContextRequest",
          "description": "Request payload for `POST /api/science/sky-context`. The time and place travel in the body, never in the\nURL, whose query string an access log prints."
        },
        "SolveRequest": {
          "properties": {
            "width": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0.0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Width"
            },
            "height": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0.0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Height"
            },
            "detections": {
              "anyOf": [
                {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
