              "title": "Latdeg"
            },
            "lonDeg": {
              "type": "number",
              "title": "Londeg"
            },
            "sourceAssetId": {
              "type": "string",
              "minLength": 1,
              "title": "Sourceassetid"
            },
            "sourceSha256": {
              "type": "string",
              "title": "Sourcesha256"
            }
          },
          "additionalProperties": true,
          "type": "object",
          "required": [
            "observedAtUTC",
            "latDeg",
            "lonDeg",
            "sourceAssetId",
            "sourceSha256"
          ],
          "title": "SolveRequest",
          "description": "Request payload for `POST /api/science/solve`."
        },
