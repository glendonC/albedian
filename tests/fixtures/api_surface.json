              "content": {
                "application/json": {
                  "schema": {
                    "additionalProperties": true,
                    "type": "object",
                    "title": "Response Post Science Ephemeris Api Science Ephemeris Post"
                  }
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/media/discover": {
        "get": {
          "summary": "Get Media Discover",
          "description": "Dynamically discover all uploaded image/video assets in `data/uploads/`,\nprobe QuickTime/container metadata via `ffprobe`, compute content SHA-256,\nlink rendered variants, and return each item's `ObservationSolution` and ephemerides.",
          "operationId": "get_media_discover_api_media_discover_get",
          "parameters": [
            {
              "name": "uploads_dir",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string",
                "default": "data/uploads",
                "title": "Uploads Dir"
              }
            },
            {
              "name": "public_dir",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string",
                "default": "apps/web/public",
                "title": "Public Dir"
              }
            },
            {
              "name": "artifacts_dir",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string",
                "default": "data/artifacts",
                "title": "Artifacts Dir"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": true,
                    "title": "Response Get Media Discover Api Media Discover Get"
                  }
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/media/restore": {
        "post": {
          "summary": "Post Media Restore",
          "description": "Execute an astronomy-aware media restoration branch and return honest signal metrics.",
          "operationId": "post_media_restore_api_media_restore_post",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestoreRequest"
                }
              }
            },
            "required": true
