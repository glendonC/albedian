          "properties": {
            "observedAtUTC": {
              "type": "string",
              "title": "Observedatutc"
            },
            "latDeg": {
              "type": "number",
              "maximum": 90.0,
              "minimum": -90.0,
              "title": "Latdeg"
            },
            "lonDeg": {
              "type": "number",
              "maximum": 180.0,
              "minimum": -180.0,
              "title": "Londeg"
            },
            "targetSepDeg": {
              "type": "number",
              "maximum": 180.0,
              "minimum": 0.5,
              "title": "Targetsepdeg"
            },
            "targetAltDeg": {
              "type": "number",
              "maximum": 90.0,
              "minimum": 0.0,
              "title": "Targetaltdeg"
