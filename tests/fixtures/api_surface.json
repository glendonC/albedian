              "title": "Detections"
            },
            "image_luma": {
              "anyOf": [
                {
                  "items": {
                    "items": {
                      "type": "number"
                    },
                    "type": "array"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Image Luma"
            },
            "hintRaDeg": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
