          },
          "requestBody": {
            "required": true,
            "description": "The file itself, with its type as Content-Type",
            "content": {
              "image/heic": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/heif": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
