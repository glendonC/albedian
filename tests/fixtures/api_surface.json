              "sourceAssetId"
            ],
            "msg": "Field required",
            "input": {
              "width": 960,
              "height": 540,
              "observedAtUTC": "2000-01-01T12:00:00Z",
              "latDeg": 0.0,
              "lonDeg": 0.0
