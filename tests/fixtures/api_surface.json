            "type": {
              "type": "string",
              "title": "Error Type"
            },
            "input": {
              "title": "Input"
            },
            "ctx": {
              "type": "object",
              "title": "Context"
            }
          },
          "type": "object",
          "required": [
            "loc",
            "msg",
            "type"
          ],
          "title": "ValidationError"
        },
        "VoiceCommandRequest": {
          "properties": {
