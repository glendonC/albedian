{
  "openapi": {
    "openapi": "3.1.0",
    "info": {
      "title": "Albedian Observation & Media Runtime API",
      "description": "Deterministic scientific astrometry, astronomy-aware media restoration, and voice action validation.",
      "version": "0.2.0"
    },
    "paths": {
      "/api/health": {
        "get": {
          "summary": "Get Health",
          "description": "Return service health and pinned catalog summary.",
          "operationId": "get_health_api_health_get",
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
                    "additionalProperties": true,
                    "type": "object",
                    "title": "Response Get Health Api Health Get"
                  }
                }
              }
            }
          }
        }
      },
      "/api/science/sky-context": {
        "get": {
          "summary": "Get Science Sky Context",
          "description": "Compute full 360-degree topocentric sky context for all 70+ navigational stars,\nSolar System ephemerides, and constellation stick-figure edges.",
          "operationId": "get_science_sky_context_api_science_sky_context_get",
          "parameters": [
            {
              "name": "obs_utc_iso",
              "in": "query",
              "required": true,
              "schema": {
                "type": "string",
                "title": "Obs Utc Iso"
              }
            },
            {
              "name": "lat_deg",
              "in": "query",
              "required": true,
              "schema": {
                "type": "number",
                "maximum": 90.0,
                "minimum": -90.0,
                "title": "Lat Deg"
              }
            },
            {
              "name": "lon_deg",
              "in": "query",
              "required": true,
              "schema": {
                "type": "number",
                "maximum": 180.0,
                "minimum": -180.0,
                "title": "Lon Deg"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": true,
                    "title": "Response Get Science Sky Context Api Science Sky Context Get"
                  }
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/science/radiometry-audit": {
        "get": {
          "summary": "Get Science Radiometry Audit",
          "description": "Return Krisciunas & Schaefer (1991) lunar sky brightness and sensor limiting magnitude audit.",
          "operationId": "get_science_radiometry_audit_api_science_radiometry_audit_get",
          "parameters": [
            {
              "name": "obs_utc_iso",
              "in": "query",
              "required": true,
              "schema": {
                "type": "string",
                "title": "Obs Utc Iso"
              }
            },
            {
              "name": "lat_deg",
              "in": "query",
              "required": true,
              "schema": {
                "type": "number",
                "maximum": 90.0,
                "minimum": -90.0,
                "title": "Lat Deg"
              }
            },
            {
              "name": "lon_deg",
              "in": "query",
              "required": true,
              "schema": {
                "type": "number",
                "maximum": 180.0,
                "minimum": -180.0,
                "title": "Lon Deg"
              }
            },
            {
              "name": "target_sep_deg",
              "in": "query",
              "required": false,
              "schema": {
                "type": "number",
                "maximum": 180.0,
                "minimum": 0.5,
                "default": 8.2,
                "title": "Target Sep Deg"
              }
            },
            {
              "name": "target_alt_deg",
              "in": "query",
              "required": false,
              "schema": {
                "type": "number",
                "maximum": 90.0,
                "minimum": 0.0,
                "default": 32.0,
                "title": "Target Alt Deg"
              }
            },
            {
              "name": "stack_frames",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "maximum": 600,
                "minimum": 1,
                "default": 9,
                "title": "Stack Frames"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": true,
                    "title": "Response Get Science Radiometry Audit Api Science Radiometry Audit Get"
                  }
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/science/solve": {
        "post": {
          "summary": "Post Science Solve",
          "description": "Run point-source extraction, triangle-matching plate solving, and held-out WCS verification.",
          "operationId": "post_science_solve_api_science_solve_post",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SolveRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
                    "additionalProperties": true,
                    "type": "object",
                    "title": "Response Post Science Solve Api Science Solve Post"
                  }
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/science/solve-horizon": {
        "post": {
          "summary": "Post Science Solve Horizon",
          "description": "Fit a camera pose to a detected celestial beacon (the Moon) and the horizon, for the given time and place.",
          "operationId": "post_science_solve_horizon_api_science_solve_horizon_post",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SolveRequest"
                }
              }
            },
            "required": true
