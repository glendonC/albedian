                  "format": "binary"
                }
              },
              "image/pjpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/tif": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/tiff": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/quicktime": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/x-m4v": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "parameters": [
            {
              "name": "X-Albedian-Filename",
              "in": "header",
              "required": false,
              "description": "The file's name, percent-encoded; used only as the local title",
              "schema": {
                "type": "string"
              }
            }
          ]
        }
      },
