  "python_forms": {
    "a list": "subprocess.run([{q}git{q}, {q}status{q}]{env})",
    "a tuple": "subprocess.check_output(({q}git{q}, {q}log{q}){env})",
    "a shell line": "subprocess.run({q}cd x && git status{q}, shell=True{env})",
    "an f-string shell line": "subprocess.run(f{q}git -C {{root}} status{q}, shell=True{env})",
    "a path to git": "subprocess.Popen([{q}/usr/bin/git{q}, {q}rev-parse{q}]{env})",
    "a list built by a call": "subprocess.run(shlex.split({q}git status{q}){env})",
    "a bytes program": "subprocess.run([b{q}git{q}, b{q}status{q}]{env})",
    "a program of a shell": "subprocess.run([{q}sh{q}, {q}-c{q}, {q}git status{q}]{env})",
    "a wrapper of its own": "sh({q}git status{q}{env})"
  },
